  "journey": {
    "steps": [
      {"note": "A typical ~50-person company: an on-prem office network with hybrid Active Directory, Microsoft 365 in the cloud, remote staff and a handful of suppliers.", "show": [], "highlight": [], "focus": true},
      {"note": "One internet connection: the ISP router hands off to a single firewall. Everything — office, remote workers, suppliers, cloud — funnels through here.", "show": [], "highlight": ["inet", "isp", "fw"], "focus": true},
      {"note": "The firewall also terminates the VPNs: always-on VPN for remote laptops (over staff home broadband) and a supplier VPN for the MSP. Both require MFA.", "show": [], "highlight": ["fw", "rlaptop", "homert", "msp", "isp"], "focus": true},
      {"note": "The firewall's management interface is only reachable from the management VLAN — two admin PAWs. Admin access from the WAN or user VLAN is switched off.", "show": [], "highlight": ["fw", "paw1", "paw2", "core"], "focus": true},
      {"note": "Inside: a core switch and three PoE access switches serve ~40 laptops (mostly on Wi-Fi), 8 desktops and 2 printers on the user VLAN.", "show": [], "highlight": ["core", "access", "wifi", "laptops", "desktops", "printers"], "focus": true},
      {"note": "On-prem identity: two domain controllers (AD DS) and an enterprise CA (AD CS) issuing certificates for Wi-Fi, VPN and devices. These are the Tier 0 crown jewels.", "show": [], "highlight": ["dc01", "dc02", "ca01"], "focus": true},
      {"note": "Entra hybrid mode: Entra Connect syncs users from AD to Entra ID with password hash sync. Conditional Access and MFA protect every cloud sign-in.", "show": [], "highlight": ["dc02", "aadc", "entra"], "focus": true},
      {"note": "Microsoft 365 carries day-to-day work: Exchange Online mail, Teams, SharePoint Online and OneDrive — all reached over HTTPS from wherever staff are.", "show": [], "highlight": ["inet", "exo", "teams", "spo", "odb", "entra"], "focus": true},
      {"note": "Microsoft Defender for Endpoint runs on every laptop, desktop and server and streams EDR telemetry to the Defender portal.", "show": [], "highlight": ["inet", "mde", "laptops", "desktops", "rlaptop", "hyperv"], "focus": true},
      {"note": "Line-of-business apps — HR, Sales CRM, Finance and ERP — run as VMs on the Hyper-V hosts and share one SQL Server, backed up nightly.", "show": [], "highlight": ["hr", "crm", "fin", "erp", "sql", "hyperv", "backup"], "focus": true},
      {"note": "IT is outsourced to an MSP: service desk, patching, backups, firewall changes and M365 / Defender admin — all through the supplier VPN with MFA, time-boxed and logged.", "show": [], "highlight": ["msp", "fw", "paw1", "mde", "entra"], "focus": true},
      {"note": "The public website is run by a third-party hosting provider, completely separate from the office network. Customers reach it directly over HTTPS.", "show": [], "highlight": ["visitors", "website", "webhost"], "focus": true},
      {"note": "Outside the walls: hybrid staff on home broadband, phones managed with Intune, and suppliers — Microsoft runs the tenant, plus the ERP vendor and payroll bureau.", "show": [], "highlight": ["hybrid", "rlaptop", "mobile", "homert", "msft", "msp", "erpv", "payroll"], "focus": true}
    ]
  }
